<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Our Diary</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Nunito:wght@400;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #FAF3E8;
    --card: #FFFDF9;
    --ink: #3A2E22;
    --ink-soft: #8A7A68;
    --line: #EADFCB;
    --accent1: #C9694B;
    --accent1-bg: #FBE9E1;
    --accent2: #4C7A8C;
    --accent2-bg: #E4EFF2;
    --gold: #D9A441;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    background-image: radial-gradient(circle at 1px 1px, #00000008 1px, transparent 0);
    background-size: 18px 18px;
    color: var(--ink);
    font-family: 'Nunito', -apple-system, sans-serif;
    padding: 28px 16px 60px;
  }
  .wrap { max-width: 480px; margin: 0 auto; }
  header { text-align: center; margin-bottom: 22px; }
  header h1 {
    font-family: 'Caveat', cursive;
    font-size: 44px;
    font-weight: 700;
    margin: 0;
    color: var(--accent1);
  }
  header p { font-size: 13px; color: var(--ink-soft); margin: 4px 0 0; }

  .card {
    background: var(--card);
    border-radius: 16px;
    border: 1px solid var(--line);
    box-shadow: 0 2px 10px rgba(58,46,34,0.05);
    padding: 20px;
    margin-bottom: 20px;
  }

  label { display: block; font-size: 12px; color: var(--ink-soft); margin: 10px 0 4px; font-weight: 600; }
  input[type=text] {
    width: 100%;
    border: 1.5px solid var(--line);
    border-radius: 10px;
    padding: 9px 10px;
    font-size: 14px;
    font-family: inherit;
    background: #FFFEFC;
    color: var(--ink);
  }
  textarea#entryText {
    width: 100%;
    border: 1.5px solid var(--line);
    border-radius: 10px;
    padding: 12px;
    font-size: 15px;
    line-height: 1.6;
    font-family: 'Nunito', sans-serif;
    background: #FFFEFC;
    color: var(--ink);
    resize: vertical;
    min-height: 100px;
  }

  .moods { display: flex; gap: 8px; margin-top: 4px; }
  .mood-btn {
    font-size: 22px;
    background: #FFFEFC;
    border: 1.5px solid var(--line);
    border-radius: 10px;
    padding: 6px 10px;
    cursor: pointer;
    opacity: 0.45;
  }
  .mood-btn.active { opacity: 1; border-color: var(--gold); background: #FFF6E4; }

  button.primary {
    margin-top: 16px;
    width: 100%;
    background: var(--accent1);
    color: #fff;
    border: none;
    border-radius: 10px;
    padding: 12px;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
  }
  button.primary:active { transform: scale(0.99); }

  .status { text-align: center; font-size: 12px; color: var(--ink-soft); margin-bottom: 10px; }

  .entry {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 16px 18px;
    margin-bottom: 14px;
    border-left: 5px solid var(--line);
  }
  .entry-top { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 6px; }
  .entry-author {
    font-family: 'Caveat', cursive;
    font-size: 22px;
    font-weight: 700;
  }
  .entry-date { font-size: 11px; color: var(--ink-soft); }
  .entry-mood { font-size: 18px; margin-right: 4px; }
  .entry-text {
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--ink);
    white-space: pre-wrap;
    margin: 0;
  }

  .empty { text-align: center; color: var(--ink-soft); font-size: 13px; padding: 36px 10px; }
</style>
</head>
<body>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-database-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-auth-compat.js"></script>
<div class="wrap">
  <header>
    <h1>Our Diary</h1>
    <p>A shared page, whenever either of us has something to say</p>
  </header>

  <div class="card">
    <label for="whoName">Who's writing?</label>
    <input type="text" id="whoName" placeholder="Your name">

    <label>Mood</label>
    <div class="moods" id="moods">
      <span class="mood-btn" data-m="😊">😊</span>
      <span class="mood-btn" data-m="😂">😂</span>
      <span class="mood-btn" data-m="😔">😔</span>
      <span class="mood-btn" data-m="😤">😤</span>
      <span class="mood-btn" data-m="😴">😴</span>
      <span class="mood-btn" data-m="🥹">🥹</span>
    </div>

    <label for="entryText">What's on your mind?</label>
    <textarea id="entryText" placeholder="Write freely..."></textarea>

    <button class="primary" id="saveBtn">Add to diary</button>
  </div>

  <div id="status" class="status"></div>
  <div id="list"></div>
</div>

<script>
  // Reuses the same Firebase project as the makan app, just a different path.
  var firebaseConfig = {
    apiKey: "AIzaSyBiwBK4A1nWC9gfOXYDchfZNiXaaezynpo",
    authDomain: "makan-6f26f.firebaseapp.com",
    databaseURL: "https://makan-6f26f-default-rtdb.asia-southeast1.firebasedatabase.app",
    projectId: "makan-6f26f",
    storageBucket: "makan-6f26f.firebasestorage.app",
    appId: "1:465005440964:web:a8a5810f6ec18dd78e7e91"
  };
  firebase.initializeApp(firebaseConfig);
  var db = firebase.database().ref('diary-entries');

  var entries = [];
  var selectedMood = null;

  var palette = ['#C9694B', '#4C7A8C', '#8A6FA8', '#5E8C4F', '#C98A1E', '#B2546A', '#3E7E85', '#A05A2C'];
  function colorForName(name) {
    var hash = 0;
    for (var i = 0; i < name.length; i++) { hash = name.charCodeAt(i) + ((hash << 5) - hash); }
    return palette[Math.abs(hash) % palette.length];
  }

  firebase.auth().signInAnonymously().catch(function(err) {
    setStatus('Could not connect — auth error.');
  });

  document.querySelectorAll('.mood-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      selectedMood = btn.getAttribute('data-m');
      document.querySelectorAll('.mood-btn').forEach(function(b) { b.classList.remove('active'); });
      btn.classList.add('active');
    });
  });

  function setStatus(msg) {
    document.getElementById('status').textContent = msg || '';
  }

  function loadEntries() {
    setStatus('Connecting...');
    db.on('value', function(snapshot) {
      var val = snapshot.val();
      entries = val ? JSON.parse(val) : [];
      setStatus('');
      render();
    }, function(err) {
      setStatus('Could not connect — check your Firebase config and database rules.');
    });
  }

  async function saveEntries() {
    try {
      await db.set(JSON.stringify(entries));
    } catch (e) {
      setStatus('Could not save — try again.');
    }
  }

  document.getElementById('saveBtn').addEventListener('click', async function() {
    var author = document.getElementById('whoName').value.trim();
    if (!author) { setStatus('Add your name first.'); return; }
    if (!selectedMood) { setStatus('Pick a mood first.'); return; }
    var text = document.getElementById('entryText').value.trim();
    if (!text) { setStatus('Write something before saving.'); return; }

    var entry = {
      id: 'e' + Date.now(),
      author: author,
      mood: selectedMood,
      text: text,
      date: new Date().toISOString()
    };
    entries.unshift(entry);
    document.getElementById('entryText').value = '';
    render();
    setStatus('Saved.');
    await saveEntries();
    setTimeout(function() { setStatus(''); }, 1500);
  });

  function render() {
    var list = document.getElementById('list');
    if (entries.length === 0) {
      list.innerHTML = '<div class="empty">No entries yet. Be the first to write something.</div>';
      return;
    }
    var sorted = entries.slice().sort(function(a, b) { return new Date(b.date) - new Date(a.date); });
    list.innerHTML = sorted.map(function(e) {
      var d = new Date(e.date);
      var dateStr = d.toLocaleDateString(undefined, { day: 'numeric', month: 'short', year: 'numeric' }) +
        ' · ' + d.toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit' });
      var color = colorForName(e.author);
      return '<div class="entry" style="border-left-color:' + color + '">' +
        '<div class="entry-top"><span class="entry-author" style="color:' + color + '">' + escapeHtml(e.author) + '</span>' +
        '<span class="entry-date">' + dateStr + '</span></div>' +
        '<p class="entry-text"><span class="entry-mood">' + e.mood + '</span>' + escapeHtml(e.text) + '</p>' +
        '</div>';
    }).join('');
  }

  function escapeHtml(str) {
    var d = document.createElement('div');
    d.textContent = str;
    return d.innerHTML;
  }

  firebase.auth().onAuthStateChanged(function(user) {
    if (user) loadEntries();
  });
</script>
</body>
</html>
